{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MLX Studio",
  "version": "0.1.0",
  "identifier": "local.mlxstudio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "title": "MLX Studio", "width": 1360, "height": 900, "minWidth": 900, "minHeight": 640 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "public.app-category.productivity",
    "externalBin": ["binaries/mlx-studio-runtime"]
  },
  "plugins": {
    "shell": { "open": false }
  }
}
